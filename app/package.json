{
  "name": "ddf-app",
  "version": "0.1.0",
  "private": true,
  "description": "Geometry-independent sender UI for the Symphonia LED dance floor. Drives mapper/ as a sidecar.",
  "type": "module",
  "scripts": {
    "dev": "npm run build:electron && vite --host 127.0.0.1",
    "dev:floor": "DDF_ADDRESS=255.255.255.255 npm run dev",
    "build": "vite build && npm run build:electron",
    "build:electron": "vite build --mode electron-main && vite build --mode electron-preload",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^26.2.0",
    "electron": "^43.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
