test-patterns*/ddf-loop-res-test/

# --- Ledset thumbnail cache ---------------------------------------------------
# Auto-regenerated by Ledset from the media folder; not authored content.
test-patterns*/thn/

# Staged into Ledset's media folder (Configure.ini's ProgramPath) so the Player
# page can see it. The tracked copy is tools/oracle/media/ -- this one is a
# staging duplicate, and docs/PRE-PROBE.md says how to put it back.
test-patterns*/09-gradient24-8x8_4P-10x5.avi

# --- Source media, not authored here ------------------------------------------
# Licensed stock footage dropped in for the real-media trials: hundreds of MB of
# h264, none of it produced by this repo, and `tools/make_clip.py` output beside
# it is equally derived. The tracked corpus is `test-patterns/*.avi` --
# generated, small, and reproducible from `tools/make_test_patterns.py`.
#
# Glob, not a literal path: the second drop arrived as "Test Clips 2" and was
# briefly one `git add -A` away from committing 192 MB. Any future "Test Clips
# <whatever>" is covered without anyone having to remember this file exists.
test-patterns/Test Clips*/

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/

# --- The app (app/, Electron + Vite) ------------------------------------------
# node_modules is not a violation of CLAUDE.md's "no third-party dependencies" —
# that rule is scoped to mapper/ and always was.
node_modules/
app/dist/
app/out/
app/release/
*.asar

# --- Swift --------------------------------------------------------------------
